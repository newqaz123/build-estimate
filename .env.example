# BuildEstimate environment template.
# Copy to .env.local and fill in real values. NEVER commit real secrets.
# Every value below is a placeholder.

# --- Auth (next-auth v5) ---
# Single shared admin password for the credentials login. Login is refused if unset/empty.
ADMIN_PASSWORD=change-me-to-a-long-random-password
# Secret used by next-auth to sign/encrypt session JWTs (generate with: npx auth secret).
AUTH_SECRET=replace-with-a-random-32-byte-secret

# --- Firebase Admin (server-side Firestore + Storage) ---
# Firebase project id.
FIREBASE_PROJECT_ID=your-firebase-project-id
# Service account client email.
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
# Service account private key; keep the literal \n sequences, they are converted to newlines.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPLACEHOLDER\n-----END PRIVATE KEY-----\n"
# Default Cloud Storage bucket for uploaded BOQ source files.
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com

# --- LLM providers ---
# Default provider when workspace settings do not choose one: openai | openrouter.
LLM_PROVIDER=openai
# Default model when workspace settings do not choose one (e.g. gpt-4o, or openai/gpt-4o on OpenRouter).
LLM_MODEL=gpt-4o
# OpenAI API key (required when provider is openai).
OPENAI_API_KEY=sk-placeholder
# OpenRouter API key (required when provider is openrouter).
OPENROUTER_API_KEY=sk-or-placeholder

# --- Docling sidecar (py-sidecar/) ---
# Local sidecar URL; matches `npm run dev:docling`. The app's saved workspace setting overrides it.
DOCLING_ENDPOINT=http://localhost:5001
# Extra comma-separated origins the server may call for Docling, besides http://localhost:5001.
DOCLING_ALLOWED_ORIGINS=
# Optional overrides for scripts/dev-docling.sh (defaults: 127.0.0.1, 5001, .venv-docling/bin/uvicorn).
DOCLING_HOST=127.0.0.1
DOCLING_PORT=5001
DOCLING_UVICORN=

# --- Internal maintenance ---
# Cleanup of expired upload previews: /api/internal/cleanup/preflight
# This path skips the login check; the route demands one of these secrets
# (compared in constant time). An unset secret accepts nothing.
#
# CRON_SECRET: for a scheduler. Send GET (or DELETE) with the header
#   Authorization: Bearer <CRON_SECRET>
# Vercel Cron sends this header automatically when CRON_SECRET is set on the project.
# Generate with: openssl rand -hex 32
CRON_SECRET=
#
# CLEANUP_SERVER_SECRET: for manual/ops calls. Send DELETE with the header
#   x-cleanup-secret: <CLEANUP_SERVER_SECRET>
CLEANUP_SERVER_SECRET=replace-with-a-random-secret
